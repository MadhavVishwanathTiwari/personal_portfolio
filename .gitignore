# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.capture-profile/
scripts/.self/

# The unredacted certificate carries a home address; the publishable copy
# lives in src/assets/credentials/ and is generated by scripts/redact-certificate.mjs
Internship_Certificate_*.png

.vercel
.env*

# Source screenshots dropped in the root for import; the processed copies
# live in src/assets/shots and are what the site uses.
img*.jpeg
WhatsApp Image*.jpeg
